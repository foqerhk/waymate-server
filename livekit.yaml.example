# Copy to livekit.yaml (or livekit.yaml.intl) and fill in.
port: 7880
bind_addresses:
  - ""
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: true
  node_ip: YOUR_PUBLIC_IP
redis: {}
keys:
  waymate_prod_key: REPLACE_WITH_LONG_RANDOM_SECRET
logging:
  level: info
room:
  empty_timeout: 300
  max_participants: 4
