# Example LiveKit config. Copy to livekit.yaml and edit before `docker compose up`.
# livekit.yaml is gitignored so production keys stay private.

port: 7880
bind_addresses:
  - ""
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: true
  # Set to your public IPv4 when use_external_ip cannot detect it (common on cloud VMs).
  # node_ip: 203.0.113.10
redis: {}
keys:
  # Must match LIVEKIT_API_KEY / LIVEKIT_API_SECRET in .env
  devkey: replace-with-livekit-secret
logging:
  level: info
room:
  empty_timeout: 300
  max_participants: 4
