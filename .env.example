HTTP_ADDR=:8080
DATABASE_URL=postgres://waymate:waymate@db:5432/waymate?sslmode=disable

# Generate long random values before production use.
JWT_SECRET=replace-with-long-random-production-secret
INVITE_HMAC_SECRET=replace-with-long-random-invite-secret

# Public HTTPS origin used in invite QR payloads (no trailing slash).
PUBLIC_BASE_URL=https://api.example.com
INVITE_TTL=876000h

# Apple Push / VoIP (optional until you enable calling notifications).
APNS_ENABLED=false
APNS_KEY_PATH=/app/secrets/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.example.waymate
APNS_PRODUCTION=false

# Self-hosted LiveKit — keys must match livekit.yaml
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=wss://api.example.com
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-livekit-secret

# Amap Web Service key (server-side only). Never ship this in the iOS app.
# Apply at: https://console.amap.com/
AMAP_WEB_KEY=

# Optional production deploy helpers (scripts/deploy.example.sh)
# DEPLOY_HOST=root@YOUR_SERVER_IP
# DEPLOY_ORIGIN_IP=YOUR_SERVER_IP
# DEPLOY_API_HOST=api.example.com
